# PostgreSQL (database-per-service)
POSTGRES_PASSWORD=pong_auth_secret
PLAYER_POSTGRES_PASSWORD=pong_player_secret

# RabbitMQ Broker
RABBITMQ_USERNAME=pong
RABBITMQ_PASSWORD=pong_secret

# AWS / MiniStack Cloud Emulator
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=test
KMS_KEY_ID=alias/ponggame-jwt-signing
ELASTICACHE_CLUSTER_ID=ponggame-redis
JWT_ISSUER=PongGame.Auth
JWT_AUDIENCE=PongGame

# Matchmaking Concurrency & Saga Controls (R2, F5, F7)
MATCHMAKING_MAX_CONCURRENT_MATCHES=10
MATCHMAKING_WINNING_SCORE=5
MATCHMAKING_PROVISIONING_TIMEOUT_MS=10000

# Simulated Slow / Unstable Arena Dependency Controls (R5, F1, F7)
DEPENDENCY_MIN_LATENCY_MS=50
DEPENDENCY_MAX_LATENCY_MS=150
DEPENDENCY_FAILURE_RATE=0.0
GAME_TICK_HZ=30

@startuml PongGame-C2

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()

skinparam backgroundColor #F8FAFC
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 12
skinparam nodesep 55
skinparam ranksep 75
skinparam padding 12
skinparam ArrowColor #64748B
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 11
skinparam titleFontColor #0F172A
skinparam titleFontSize 24
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #CBD5E1

UpdateElementStyle("person", $bgColor="#334155", $fontColor="#FFFFFF", $borderColor="#1E293B")
UpdateElementStyle("container", $bgColor="#EFF6FF", $fontColor="#1E3A5F", $borderColor="#60A5FA")

title Pong Game - Distributed Architecture (C2)

Person(player, "Player", "Plays real-time Pong online via HTTP & WebSocket.")

System_Boundary(pong, "Pong Game Distributed System") {

    Container(frontend, "Frontend", "React + TypeScript (Vite)", "Auth, matchmaking lobby, player stats, leaderboard & real-time Canvas Pong arena.")
    Container(gateway, "API Gateway", "Nginx", "Serves SPA (/), routes HTTP APIs & load-balances WebSockets across Game replicas.")

    Container(auth, "Auth Service", "C# / .NET 10", "Registration, login, refresh, recovery. Signs JWTs via AWS KMS asymmetric RSA key.")
    ContainerDb(authDb, "Auth Database", "PostgreSQL 17", "Isolated credentials & refresh sessions.")

    Container(playerService, "Player Service", "Java 21 / Spring Boot", "Player profiles, ELO statistics, match history, transactional idempotency.")
    ContainerDb(playerDb, "Player Database", "PostgreSQL 17", "Isolated profiles, matches & processed_messages.")

    Container(matchmaking, "Matchmaking Service", "Java 21 / Spring Boot", "Async 202 queue API, Redis Lua pairing & slot concurrency control, Saga compensation.")

    Container(game, "Game Service (x2+ replicas)", "Go 1.24", "WebSocket real-time Pong engine, competing consumers, lease failover, unstable dependency simulator.")

    ContainerQueue(rabbit, "Message Broker", "RabbitMQ 4", "Topic exchange (pong.events) + DLX/DLQ for event-driven choreography.")

    System_Boundary(cloud, "AWS Cloud Services (MiniStack / Terraform)") {
        Container(kms, "AWS KMS", "Asymmetric RSA-2048", "Private key signing in Auth; cached GetPublicKey verification across services.")
        ContainerDb(elasticache, "AWS ElastiCache (Redis)", "Redis 7", "Matchmaking queue/locks, distributed game state & Pub/Sub, Player cache.")
        Container(ssm, "AWS SSM Parameter Store", "Parameters", "Centralized runtime configuration provisioned via Terraform.")
    }
}

Rel(player, gateway, "Browser SPA, REST & real-time Pong", "HTTP / WS")

Rel(gateway, frontend, "/ (SPA assets)", "HTTP")

Rel(gateway, auth, "/api/auth/*", "HTTP")
Rel(gateway, playerService, "/api/players/*", "HTTP")
Rel(gateway, matchmaking, "/api/matchmaking/*", "HTTP")
Rel(gateway, game, "/api/game/* & /ws/game/* (LB)", "HTTP / WS")

Rel(auth, authDb, "Reads & writes")
Rel(playerService, playerDb, "Reads & writes")

Rel(auth, kms, "Sign (RSASSA_PKCS1_V1_5_SHA_256) & GetPublicKey")
Rel(playerService, kms, "GetPublicKey (cached)")
Rel(matchmaking, kms, "GetPublicKey (cached)")
Rel(game, kms, "GetPublicKey (cached)")

Rel(playerService, elasticache, "Caches profiles")
Rel(matchmaking, elasticache, "Queues, Lua locks, outbox")
Rel(game, elasticache, "Distributed state, Pub/Sub, leases, outbox")

Rel(matchmaking, rabbit, "Publishes match.created, match.cancel; consumes ready/failed/finished", "AMQP")
Rel(game, rabbit, "Consumes match.created/cancel; publishes ready/failed/finished", "AMQP")
Rel(playerService, rabbit, "Consumes match.finished (multi-consumer event)", "AMQP")

SHOW_LEGEND()
@enduml
